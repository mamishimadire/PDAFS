@{
    ViewData["Title"] = "AFS Comparison Workspace";
    ViewData["Step"] = "1";
    var desktopPath = System.IO.Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.Desktop), "AFS_Comparison");
}

<form id="__afs-af-form">@Html.AntiForgeryToken()</form>

@section Sidebar {
<aside class="app-sidebar">
    <!-- Brand -->
    <div class="sb-brand">
        <span class="sb-logo-box">SNG</span>
        <div class="sb-brand-text">
            <div class="sb-brand-name">Grant Thornton</div>
            <div class="sb-brand-sub">South Africa · CAATs</div>
        </div>
    </div>

    <!-- Navigation -->
    <nav class="sb-nav">
        <div class="sb-nav-label">Workflow Steps</div>

        <button type="button" class="sb-nav-item active" data-step-nav="step1" onclick="focusStep('step1')">
            <span class="sb-nav-icon">1</span>
            <span class="sb-nav-copy">
                <span class="sb-nav-title">Engagement</span>
                <span class="sb-nav-sub">Client &amp; audit context</span>
            </span>
            <span class="sb-nav-badge is-live" id="nav-status-step1">Ready</span>
        </button>

        <button type="button" class="sb-nav-item" data-step-nav="step2" onclick="focusStep('step2')">
            <span class="sb-nav-icon">2</span>
            <span class="sb-nav-copy">
                <span class="sb-nav-title">Upload</span>
                <span class="sb-nav-sub">Baseline &amp; comparand PDFs</span>
            </span>
            <span class="sb-nav-badge is-pending" id="nav-status-step2">Pending</span>
        </button>

        <button type="button" class="sb-nav-item" data-step-nav="step3" onclick="focusStep('step3')">
            <span class="sb-nav-icon">3</span>
            <span class="sb-nav-copy">
                <span class="sb-nav-title">Extract</span>
                <span class="sb-nav-sub">Read pages &amp; reconstruct text</span>
            </span>
            <span class="sb-nav-badge is-pending" id="nav-status-step3">Pending</span>
        </button>

        <button type="button" class="sb-nav-item" data-step-nav="step4" onclick="focusStep('step4')">
            <span class="sb-nav-icon">4</span>
            <span class="sb-nav-copy">
                <span class="sb-nav-title">Compare &amp; Review</span>
                <span class="sb-nav-sub">Diff, insights &amp; review</span>
            </span>
            <span class="sb-nav-badge is-pending" id="nav-status-step4">Pending</span>
        </button>

        <button type="button" class="sb-nav-item" data-step-nav="step5" onclick="focusStep('step5')">
            <span class="sb-nav-icon">5</span>
            <span class="sb-nav-copy">
                <span class="sb-nav-title">Export</span>
                <span class="sb-nav-sub">Save working papers</span>
            </span>
            <span class="sb-nav-badge is-pending" id="nav-status-step5">Pending</span>
        </button>

        <div class="sb-nav-label" style="margin-top:12px">Capabilities</div>
        <div style="padding:10px 10px 4px;font-size:11.5px;color:var(--sb-muted);line-height:1.6">
            Smart page alignment · materiality review · Word-level diff · PDF/Word/Excel export
        </div>

        <div style="margin-top:8px;padding:0 10px">
            <div style="background:rgba(200,16,46,0.18);border:1px solid rgba(200,16,46,0.3);border-radius:10px;padding:9px 12px">
                <div style="color:#ff9ab1;font-size:10px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:4px">Boost Status</div>
                <div style="color:rgba(255,255,255,0.8);font-size:11.5px">Active</div>
            </div>
        </div>
    </nav>

    <!-- Sidebar footer -->
    <div class="sb-footer">
        <button class="sb-theme-btn" type="button" onclick="toggleDarkMode()" id="themeTog">
            <span>🌙</span> Dark Mode
        </button>
    </div>
</aside>
}

<!-- Page header hero -->
<section class="page-header">
    <div class="page-header-left">
        <div class="page-header-kicker">CAATs Platform · AFS PDF Comparison Analyser</div>
        <h1 class="page-header-title">
            Audit Review Workspace
            <span class="page-header-ver">v5.0</span>
        </h1>
        <p class="page-header-sub">
            Smart extraction, page alignment, semantic diff, and working paper export — all in one surface.
        </p>
        <div class="page-header-pills">
            <span class="page-header-pill">Same</span>
            <span class="page-header-pill">Changed</span>
            <span class="page-header-pill">Added</span>
            <span class="page-header-pill">Removed</span>
            <span class="page-header-pill" style="background:rgba(200,16,46,0.22);border-color:rgba(200,16,46,0.35);color:#ffb3bf">Insights</span>
            <span class="page-header-pill" style="background:rgba(59,130,246,0.2);border-color:rgba(59,130,246,0.35);color:#93c5fd">Snapshot</span>
        </div>
    </div>
    <div class="page-header-right">
        <div class="page-header-status-card">
            <span class="page-header-status-label">Workspace Status</span>
            <div class="page-header-status-val" id="workflow-stage">Awaiting engagement details</div>
        </div>
    </div>
</section>

<!-- KPI / metrics grid -->
<section class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-card-label">Queued PDFs</div>
        <div class="kpi-card-value" id="metric-queue">0</div>
        <div class="kpi-card-sub">Files ready for extraction</div>
        <div class="kpi-card-dot"></div>
    </div>
    <div class="kpi-card">
        <div class="kpi-card-label">Extracted Reports</div>
        <div class="kpi-card-value" id="metric-extracted">0</div>
        <div class="kpi-card-sub">Reports with text available</div>
        <div class="kpi-card-dot"></div>
    </div>
    <div class="kpi-card">
        <div class="kpi-card-label">Aligned Page Pairs</div>
        <div class="kpi-card-value" id="metric-pairs">0</div>
        <div class="kpi-card-sub">Pairs ready for visual review</div>
        <div class="kpi-card-dot"></div>
    </div>
    <div class="kpi-card">
        <div class="kpi-card-label">Changed Items</div>
        <div class="kpi-card-value" id="metric-changed">0</div>
        <div class="kpi-card-sub">Changed + added + removed</div>
        <div class="kpi-card-dot"></div>
    </div>
</section>

<!-- Five-step workflow accordion -->
<section class="workflow-shell">
    <div class="workflow-head">
        <div class="workflow-head-left">
            <div class="workflow-head-kicker">Review Flow</div>
            <h2 class="workflow-head-title">Five-step audit dashboard</h2>
        </div>
        <div class="workflow-head-sub">
            Each step expands in place. The sidebar stays visible for quick navigation between steps.
        </div>
    </div>

    <div class="afs-accordion" id="afsAccordion">

        <!-- STEP 1: ENGAGEMENT -->
        <div class="afs-acc-item" id="acc-step1">
            <button class="afs-acc-header is-open" onclick="toggleAcc('step1')">
                <span class="afs-step-num">1</span>
                <span class="afs-step-copy">
                    <span class="afs-step-label">Engagement Details</span>
                    <span class="afs-step-desc">Capture client metadata used in the comparison and export set.</span>
                </span>
                <span class="afs-step-state is-live" id="step-state-step1">Ready</span>
                <span class="afs-acc-arrow is-open" id="arrow-step1">▼</span>
            </button>
            <div class="afs-acc-body" id="body-step1" style="display:block">
                <div class="afs-info afs-info-purple mb-3">
                    Enter engagement metadata. This information is stamped into every working paper output.
                </div>
                <form id="engForm" onsubmit="return false">
                    <div class="afs-field-grid">
                        <div class="afs-field">
                            <label class="afs-label">Parent Name</label>
                            <input class="afs-input" id="eng_parent" name="parent" placeholder="Holding company or group name" />
                        </div>
                        <div class="afs-field">
                            <label class="afs-label">Client Name</label>
                            <input class="afs-input" id="eng_client" name="client" placeholder="Audit client or entity name" />
                        </div>
                        <div class="afs-field">
                            <label class="afs-label">Engagement Name</label>
                            <input class="afs-input" id="eng_engname" name="engagementName" placeholder="Annual audit FY2025" />
                        </div>
                        <div class="afs-field">
                            <label class="afs-label">Engagement Number</label>
                            <input class="afs-input" id="eng_engnum" name="engagementNumber" placeholder="2025-AUD-001" />
                        </div>
                        <div class="afs-field">
                            <label class="afs-label">Financial Year Start</label>
                            <input class="afs-input" id="eng_fystart" name="financialYearStart" placeholder="2025-03-01" />
                        </div>
                        <div class="afs-field">
                            <label class="afs-label">Financial Year End</label>
                            <input class="afs-input" id="eng_fyend" name="financialYearEnd" placeholder="2026-02-28" />
                        </div>
                        <div class="afs-field">
                            <label class="afs-label">Prepared By</label>
                            <input class="afs-input" id="eng_auditor" name="preparedBy" placeholder="Auditor name" />
                        </div>
                        <div class="afs-field">
                            <label class="afs-label">Director</label>
                            <input class="afs-input" id="eng_director" name="director" placeholder="Engagement director" />
                        </div>
                        <div class="afs-field">
                            <label class="afs-label">Manager</label>
                            <input class="afs-input" id="eng_manager" name="manager" placeholder="Engagement manager" />
                        </div>
                    </div>
                    <div class="afs-field mt-2">
                        <label class="afs-label">Audit Objective</label>
                        <textarea class="afs-input afs-textarea" id="eng_objective" name="objective" rows="4">To independently compare two versions of the Annual Financial Statements (AFS) through automated computer-assisted audit techniques (CAATs), identifying all textual, numerical, and structural differences on a line-by-line and number-by-number basis, in order to support audit evidence gathering and financial statement accuracy assessments in accordance with ISA 500 (Audit Evidence).</textarea>
                    </div>
                    <div class="afs-btn-row mt-3">
                        <button class="afs-btn afs-btn-success" type="button" onclick="saveEngagement()">
                            ✓ Save Details
                        </button>
                        <span id="eng-status" class="afs-status"></span>
                    </div>
                </form>
            </div>
        </div>

        <!-- STEP 2: UPLOAD -->
        <div class="afs-acc-item" id="acc-step2">
            <button class="afs-acc-header" onclick="toggleAcc('step2')">
                <span class="afs-step-num">2</span>
                <span class="afs-step-copy">
                    <span class="afs-step-label">Upload AFS PDFs</span>
                    <span class="afs-step-desc">Upload the two PDFs to compare. Different page counts are handled through smart content alignment.</span>
                </span>
                <span class="afs-step-state is-pending" id="step-state-step2">Pending</span>
                <span class="afs-acc-arrow" id="arrow-step2">▼</span>
            </button>
            <div class="afs-acc-body" id="body-step2" style="display:none">
                <div class="afs-info afs-info-green mb-3">
                    Upload the <strong>baseline PDF first</strong>, then the comparison PDF. The comparison engine handles different page counts automatically.
                </div>
                <div class="afs-btn-row mb-3">
                    <label class="afs-btn afs-btn-primary afs-file-trigger">
                        ↑ Select PDFs
                        <input type="file" id="pdfInput" accept=".pdf" multiple style="display:none" onchange="addToQueue()" />
                    </label>
                    <button class="afs-btn afs-btn-danger" type="button" onclick="clearQueue()">✕ Clear Queue</button>
                    <span id="upload-status" class="afs-status"></span>
                </div>
                <div class="afs-panel-block">
                    <div class="afs-panel-kicker">Files in Queue</div>
                    <div id="queue-table-body">
                        <div class="afs-empty-state">No PDFs queued yet.</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- STEP 3: EXTRACT -->
        <div class="afs-acc-item" id="acc-step3">
            <button class="afs-acc-header" onclick="toggleAcc('step3')">
                <span class="afs-step-num">3</span>
                <span class="afs-step-copy">
                    <span class="afs-step-label">Extract Content</span>
                    <span class="afs-step-desc">Read PDF pages, reconstruct lines, and prepare report text for comparison.</span>
                </span>
                <span class="afs-step-state is-pending" id="step-state-step3">Pending</span>
                <span class="afs-acc-arrow" id="arrow-step3">▼</span>
            </button>
            <div class="afs-acc-body" id="body-step3" style="display:none">
                <div class="afs-info afs-info-violet mb-3">
                    Multi-tier extraction with smart document intelligence for scanned documents.
                    Extraction preserves page text so visual snapshots can anchor highlights accurately in Step 4.
                </div>
                <div class="afs-btn-row mb-3">
                    <button class="afs-btn afs-btn-primary" type="button" onclick="extractPdfs()">
                        ⚡ Extract All PDFs
                    </button>
                    <span id="extract-status" class="afs-status"></span>
                </div>
                <div id="extract-results"></div>
            </div>
        </div>

        <!-- STEP 4: COMPARE -->
        <div class="afs-acc-item" id="acc-step4">
            <button class="afs-acc-header" onclick="toggleAcc('step4')">
                <span class="afs-step-num">4</span>
                <span class="afs-step-copy">
                    <span class="afs-step-label">Compare &amp; Review</span>
                    <span class="afs-step-desc">Smart diff engine, page pair inspection, snapshot viewer, and auditor notes.</span>
                </span>
                <span class="afs-step-state is-pending" id="step-state-step4">Pending</span>
                <span class="afs-acc-arrow" id="arrow-step4">▼</span>
            </button>
            <div class="afs-acc-body" id="body-step4" style="display:none">
                <div class="afs-info afs-info-amber mb-3">
                    <strong>Smart page alignment</strong> · sentence-aware line diff · semantic block comparison ·
                    <strong>intelligent materiality review</strong> · page pair visual snapshots with highlights.
                </div>
                <div class="afs-btn-row mb-3">
                    <button class="afs-btn afs-btn-warning" type="button" onclick="runComparison()">
                        ▶ Run Comparison
                    </button>
                    <span id="compare-status" class="afs-status"></span>
                </div>
                <div id="compare-progress" style="display:none">
                    <div class="afs-progress-wrap">
                        <div class="afs-progress-bar" id="compare-prog-bar"></div>
                    </div>
                    <div class="afs-progress-label" id="compare-prog-label">Running...</div>
                </div>
                <div id="compare-results"></div>
            </div>
        </div>

        <!-- STEP 5: EXPORT -->
        <div class="afs-acc-item" id="acc-step5">
            <button class="afs-acc-header" onclick="toggleAcc('step5')">
                <span class="afs-step-num">5</span>
                <span class="afs-step-copy">
                    <span class="afs-step-label">Save Working Papers</span>
                    <span class="afs-step-desc">Export the completed review pack in all formats required by the file.</span>
                </span>
                <span class="afs-step-state is-pending" id="step-state-step5">Pending</span>
                <span class="afs-acc-arrow" id="arrow-step5">▼</span>
            </button>
            <div class="afs-acc-body" id="body-step5" style="display:none">
                <div class="afs-info afs-info-green mb-3">
                    Save a working paper set with cover details, aligned snapshots, line changes, number comparison, AI findings, and auditor comments.
                </div>
                <div class="afs-field mb-3" style="max-width:540px">
                    <label class="afs-label">Output Folder</label>
                    <input class="afs-input" id="export_folder" value="@desktopPath"
                           placeholder="C:\Users\...\Desktop\AFS_Comparison" />
                </div>
                <div class="afs-checkbox-row mb-3">
                    <label class="afs-chk-card">
                        <input type="checkbox" id="chk_pdf" checked /> PDF Working Paper
                    </label>
                    <label class="afs-chk-card">
                        <input type="checkbox" id="chk_word" checked /> Word (.docx)
                    </label>
                    <label class="afs-chk-card">
                        <input type="checkbox" id="chk_excel" checked /> Excel (.xlsx)
                    </label>
                    <label class="afs-chk-card">
                        <input type="checkbox" id="chk_text" checked /> Text Report
                    </label>
                </div>
                <div class="afs-btn-row mb-3">
                    <button class="afs-btn afs-btn-success" type="button" onclick="saveWorkingPapers()">
                        ↓ Save Working Papers
                    </button>
                    <span id="export-status" class="afs-status"></span>
                </div>
                <div id="export-results"></div>
            </div>
        </div>

    </div>
</section>

@section Scripts {
<script src="~/js/afs-app.js" asp-append-version="true"></script>
}
